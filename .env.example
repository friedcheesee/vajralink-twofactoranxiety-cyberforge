# Copy this file to .env and fill in what you have. Every value here is optional - VajraLink runs and
# scores correctly without any of them, falling back to deterministic logic instead of faking a result.
# .env is gitignored and never baked into the Docker image; docker-compose.yml reads it fresh on every
# `docker compose up`.

# Enables live grey-zone correlation calls, the AI decoy second opinion, and filter-bypass payload
# synthesis (all real gpt-4o-mini chat-completions calls, cached in vajra_state.db). Without this,
# those decisions use deterministic fallback rules instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Enables pushing the real Vault migration plan to an actual HashiCorp Vault instance. Without these,
# /api/vault/migration still builds the real plan from your SAST findings - it just can't push it anywhere.
VAULT_ADDR=
VAULT_TOKEN=
