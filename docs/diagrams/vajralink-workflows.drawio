<mxfile host="app.diagrams.net" type="device"><diagram name="SAST workflow" id="SAST_workflow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b style='font-size:20px'&gt;SAST workflow&lt;/b&gt;&lt;br&gt;From source code to active sinks, suppressed decoys, and a targeted route plan for DAST." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="50" as="geometry"/></mxCell><mxCell id="v2" value="Source code&lt;br&gt;(repo or ./targets/&amp;lt;app&amp;gt;)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="70" width="240" height="70" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Parse the project&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;route maps (URL → handler, inputs) · function graph (calls, @Service DI, interfaces)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="170" width="400" height="60" as="geometry"/></mxCell><mxCell id="v4" value="&lt;i&gt;The engines run independently on the same code.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="252" width="400" height="20" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;Java taint engine&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;request inputs → sinks through locals, helpers and DI (up to 4 calls)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="280" width="216" height="85" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;Sink-signature scanner&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;dangerous API called with dynamic input · + Python taint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="252" y="280" width="216" height="85" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;Secrets scanner&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;secret-named literals, JWT keys, config, key files&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="484" y="280" width="216" height="85" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;Semgrep&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;rules synthesised from this project's sinks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="716" y="280" width="216" height="85" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;Bandit&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Python projects&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=12;" vertex="1" parent="1"><mxGeometry x="948" y="280" width="216" height="85" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;Normalise to one finding format (FR-3)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;CWE · file · line · enclosing method · code snippet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="410" width="400" height="55" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;Merge by sink&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;one finding per (file, method, CWE) · records which engines agreed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="495" width="400" height="55" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b&gt;Is the sink guarded?&lt;/b&gt;&lt;br&gt;bound SQL parameters · HTML encoding · allow-list · path normalised + base check · constant command" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="580" width="360" height="150" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;Suppressed decoy&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;kept with its reason, not reported (B-2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="620" width="260" height="70" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;Active SAST sink&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;file · line · CWE · snippet (FR-1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="770" width="300" height="60" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;AI second opinion (optional)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Decisions API returns P(safe) per decoy.&lt;br&gt;Shown next to the rule verdict; never changes it.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="870" y="740" width="260" height="85" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;Targeted route plan&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;routes whose handler reaches an active sink, with CWE hints&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="870" width="400" height="55" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;→ DAST&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;probe these routes for these classes first&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="960" width="260" height="50" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;→ Correlation&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;active sinks, suppressed decoys, routes, call graph&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="960" width="260" height="50" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v2" target="v3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v3" target="v5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v5" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v3" target="v6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v6" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v3" target="v7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v7" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v3" target="v8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v8" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v3" target="v9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v9" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v10" target="v11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v11" target="v12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="v12" target="v13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e33" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v12" target="v14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;dashed=1;" edge="1" parent="1" source="v13" target="v15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v14" target="v16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v16" target="v17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v16" target="v18"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="DAST workflow" id="DAST_workflow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b style='font-size:20px'&gt;DAST workflow&lt;/b&gt;&lt;br&gt;Every finding comes from a real HTTP response. An unreachable target gives zero findings, never simulated ones." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="50" as="geometry"/></mxCell><mxCell id="v2" value="Target URL" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="70" width="200" height="60" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Localhost or private network?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="160" width="240" height="110" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;Refused&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;no request is sent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="185" width="200" height="60" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;Running in Docker?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;localhost / 127.0.0.1 → host.docker.internal&lt;br&gt;(your machine), noted in the result&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="185" width="300" height="60" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;Reachable?&lt;/b&gt;&lt;br&gt;4 tries · any HTTP response counts" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="300" width="240" height="110" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;0 findings&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;the reason is reported in the result&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="325" width="200" height="60" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;Header / TLS / CORS audit&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;missing security headers etc. → Runtime-only findings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="440" width="300" height="60" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;Endpoint discovery&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;route table · SAST plan with CWE hints · katana / link crawl · decoy-audit routes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="440" width="300" height="70" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;Input derivation&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;route params · path variables · JSON body fields · forms and links on the page · generic names only if the app reacts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="540" width="300" height="80" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;For each endpoint × CWE class&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;SAST hint first · no hint: SQLi, command, traversal, redirect, XXE + browser XSS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="650" width="300" height="65" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b&gt;Baseline request&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;normal response to compare against&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="750" width="260" height="55" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;Send probe&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;payload library · AI bypass payload first when SAST found a guard and a key is set · transport errors retried&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="830" width="260" height="80" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;Confirmation rule met?&lt;/b&gt;&lt;br&gt;proof marker · DB error · true/false pair · redirect target" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="940" width="280" height="130" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;Control request&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;same parameter, harmless value&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="1100" width="260" height="50" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;Marker still there?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="1180" width="220" height="100" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;Rejected&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;stored text, not execution&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="1200" width="200" height="60" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;Playwright browser check&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;real Chromium loads the payload · script execution verified · screenshot&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="750" width="280" height="70" as="geometry"/></mxCell><mxCell id="v19" value="&lt;b&gt;DAST finding (FR-2)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;URL · parameter · payload · evidence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="1100" width="280" height="60" as="geometry"/></mxCell><mxCell id="v20" value="&lt;b&gt;→ Correlation&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="1200" width="280" height="45" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v2" target="v3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v3" target="v4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="v3" target="v5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v3" target="v6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v6" target="v7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="v6" target="v8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v6" target="v9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v9" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v10" target="v11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="HTTP classes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="v11" target="v12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" value="XSS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="v11" target="v18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v12" target="v13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v13" target="v14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e34" value="no: next probe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v14" target="v13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e35" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v14" target="v15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v15" target="v16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e37" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v16" target="v17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e38" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v16" target="v19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e39" value="executed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v18" target="v19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v19" target="v20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="v8" target="v19"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Correlation and decisions" id="Correlation_and_decisions"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="1220" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b style='font-size:20px'&gt;Correlation and decisions&lt;/b&gt;&lt;br&gt;A wrong link is worse than a missed one, so every uncertain case falls to the safer side." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="50" as="geometry"/></mxCell><mxCell id="v2" value="DAST finding" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="70" width="220" height="60" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Route lookup&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;which handler serves this URL · context path and path templates tolerated&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="160" width="340" height="60" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;Handler found?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="250" width="200" height="90" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;Code-path proof&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;handler's lines contain the sink, or a call path reaches it (helpers, @Service DI, function graph) · same CWE family&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="370" width="340" height="75" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;Score 5 evidence vectors&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;0.30 code path + 0.25 CWE + 0.15 parameter + 0.15 evidence fits sink + 0.15 filter parity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="475" width="340" height="70" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;S ≥ 0.72 and path proven?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="575" width="260" height="110" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;Confirmed&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;deterministic proof, no LLM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="600" width="220" height="60" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;S ≥ 0.48?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="715" width="200" height="90" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;Grey-zone arbiter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;gpt-4o-mini sees handler code, sink line, runtime evidence · strict JSON · cached&lt;br&gt;&lt;i&gt;No key: link only if the parameter AND the evidence type both match&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="410" y="835" width="340" height="90" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;Linked?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="955" width="200" height="90" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b&gt;Runtime only&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;proven at runtime, no code link&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="420" width="220" height="60" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;Sink suppressed as a decoy?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;direct evidence (DB error, command output, executed script) overrides · inference-only → &lt;i&gt;contested&lt;/i&gt;, not reported&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="370" width="300" height="90" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;Merge by sink (FR-6)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;one issue per (file, method, CWE) · every URL that reaches it is listed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="715" width="300" height="60" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;Unlinked SAST sinks → Code only&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="805" width="300" height="45" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;Auto-verify (B-1, opt-in)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;probe Code-only sinks through routes that reach them, then correlate again&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="820" y="880" width="300" height="65" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;Prioritise (FR-9)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Confirmed first, then risk score: status + severity + flags&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="975" width="300" height="55" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;Explain (B-3) + fix (B-4)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;plain-English reason and pass/fail checklist per link&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="1055" width="300" height="55" as="geometry"/></mxCell><mxCell id="v19" value="&lt;b&gt;Outputs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;issues API · SARIF + CI gate · scan compare · Postman · Vault plan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0eef0;strokeColor=#2a9da5;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="1135" width="300" height="55" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v2" target="v3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v3" target="v4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="v4" target="v12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v4" target="v5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;dashed=1;" edge="1" parent="1" source="v5" target="v13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v6" target="v7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v7" target="v8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v7" target="v9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v9" target="v12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v9" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v10" target="v11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v11" target="v8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e33" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v11" target="v12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v8" target="v14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v14" target="v15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v15" target="v16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e37" value="new proofs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v16" target="v2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v16" target="v17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v17" target="v18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="v18" target="v19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v12" target="v14"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>