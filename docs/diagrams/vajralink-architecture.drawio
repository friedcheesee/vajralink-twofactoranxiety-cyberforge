<mxfile host="app.diagrams.net" type="device"><diagram name="Architecture" id="Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b style='font-size:20px'&gt;VajraLink architecture&lt;/b&gt;&lt;br&gt;Solid arrows always run. Dashed arrows are optional (need an API key, or are opt-in). Requests only ever go to the local target app and, if configured, OpenAI." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1150" height="50" as="geometry"/></mxCell><mxCell id="v2" value="&lt;b&gt;Source repository&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;git URL or ./targets/&amp;lt;app&amp;gt;&lt;br&gt;Java or Python&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="200" height="80" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;Running app&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;localhost or private network only&lt;br&gt;(in Docker: localhost → host.docker.internal)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="200" height="90" as="geometry"/></mxCell><mxCell id="v4" value="Interfaces (FR-10)" style="swimlane;startSize=28;html=1;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;swimlaneFillColor=#ffffff;arcSize=4;" vertex="1" parent="1"><mxGeometry x="260" y="70" width="1180" height="100" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;Dashboard&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;vajra/web/static&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="v4"><mxGeometry x="20" y="38" width="360" height="50" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;REST API (FastAPI)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;POST /scans · GET /issues · GET /issues/{id} · compare&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="v4"><mxGeometry x="410" y="38" width="360" height="50" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;CLI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;vajra scan · diff · eval&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="v4"><mxGeometry x="800" y="38" width="360" height="50" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;Scan orchestrator: run_full_scan()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;static → DAST → correlate → (auto-verify) → report · per-stage timings · stored in SQLite&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="195" width="1180" height="55" as="geometry"/></mxCell><mxCell id="v9" value="Static analysis (SAST)" style="swimlane;startSize=28;html=1;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;swimlaneFillColor=#ffffff;arcSize=4;" vertex="1" parent="1"><mxGeometry x="260" y="280" width="380" height="470" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;Route maps&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Spring · Servlet · JAX-RS · Flask · FastAPI · Django&lt;br&gt;URL → handler file, line span, inputs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" vertex="1" parent="v9"><mxGeometry x="15" y="40" width="350" height="60" as="geometry"/></mxCell><mxCell id="v11" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;arcSize=12;dashed=1;" vertex="1" parent="v9"><mxGeometry x="15" y="112" width="350" height="175" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b&gt;SAST engines&lt;/b&gt; (each runs on every file)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="v9"><mxGeometry x="25" y="116" width="300" height="20" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;Java taint&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;sources → sinks via helpers, DI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=12;" vertex="1" parent="v9"><mxGeometry x="25" y="140" width="160" height="40" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;Sink signatures&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;+ Python taint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=12;" vertex="1" parent="v9"><mxGeometry x="195" y="140" width="160" height="40" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;Secrets scanner&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;code, config, key files&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=12;" vertex="1" parent="v9"><mxGeometry x="25" y="186" width="160" height="40" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;Semgrep&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;rules synthesised per project&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=12;" vertex="1" parent="v9"><mxGeometry x="195" y="186" width="160" height="40" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;Bandit&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Python&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=12;" vertex="1" parent="v9"><mxGeometry x="25" y="232" width="160" height="40" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;Merge + decoy filter (B-2)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;one finding per sink · guarded code suppressed with a reason&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" vertex="1" parent="v9"><mxGeometry x="15" y="300" width="350" height="55" as="geometry"/></mxCell><mxCell id="v19" value="&lt;b&gt;Function graph&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;call edges, DI, interfaces&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" vertex="1" parent="v9"><mxGeometry x="15" y="367" width="165" height="55" as="geometry"/></mxCell><mxCell id="v20" value="&lt;b&gt;Targeted route plan&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;routes reaching a sink + CWE hints&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" vertex="1" parent="v9"><mxGeometry x="200" y="367" width="165" height="55" as="geometry"/></mxCell><mxCell id="v21" value="Dynamic analysis (DAST)" style="swimlane;startSize=28;html=1;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=14;swimlaneFillColor=#ffffff;arcSize=4;" vertex="1" parent="1"><mxGeometry x="660" y="280" width="380" height="470" as="geometry"/></mxCell><mxCell id="v22" value="&lt;b&gt;Safety gate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;refuses any non-local target&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=12;" vertex="1" parent="v21"><mxGeometry x="15" y="40" width="350" height="40" as="geometry"/></mxCell><mxCell id="v23" value="&lt;b&gt;Header / TLS / CORS audit&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;runtime-only findings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=12;" vertex="1" parent="v21"><mxGeometry x="15" y="90" width="350" height="40" as="geometry"/></mxCell><mxCell id="v24" value="&lt;b&gt;Endpoint discovery&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;route table + SAST plan · katana / link crawl · decoy audit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=12;" vertex="1" parent="v21"><mxGeometry x="15" y="140" width="350" height="50" as="geometry"/></mxCell><mxCell id="v25" value="&lt;b&gt;Input derivation&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;route params · path vars · body fields · page forms&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=12;" vertex="1" parent="v21"><mxGeometry x="15" y="200" width="350" height="50" as="geometry"/></mxCell><mxCell id="v26" value="&lt;b&gt;HTTP differential verifier&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;SQLi · command · traversal · redirect · XXE&lt;br&gt;baseline → probe → rule → control request&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=12;" vertex="1" parent="v21"><mxGeometry x="15" y="260" width="350" height="65" as="geometry"/></mxCell><mxCell id="v27" value="&lt;b&gt;Playwright browser proof&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;real Chromium executes XSS · screenshot&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=12;" vertex="1" parent="v21"><mxGeometry x="15" y="335" width="350" height="50" as="geometry"/></mxCell><mxCell id="v28" value="&lt;b&gt;DAST findings&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;URL · parameter · payload · evidence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=12;" vertex="1" parent="v21"><mxGeometry x="15" y="400" width="350" height="50" as="geometry"/></mxCell><mxCell id="v29" value="Correlation engine (own work)" style="swimlane;startSize=28;html=1;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;swimlaneFillColor=#ffffff;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1060" y="280" width="380" height="470" as="geometry"/></mxCell><mxCell id="v30" value="&lt;b&gt;Route lookup&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;which handler serves this URL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;arcSize=12;" vertex="1" parent="v29"><mxGeometry x="15" y="40" width="350" height="50" as="geometry"/></mxCell><mxCell id="v31" value="&lt;b&gt;Code-path proof&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;does that handler reach a sink of the same CWE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;arcSize=12;" vertex="1" parent="v29"><mxGeometry x="15" y="100" width="350" height="50" as="geometry"/></mxCell><mxCell id="v32" value="&lt;b&gt;5-vector score&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;path · CWE · parameter · evidence fit · filter parity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;arcSize=12;" vertex="1" parent="v29"><mxGeometry x="15" y="160" width="350" height="50" as="geometry"/></mxCell><mxCell id="v33" value="&lt;b&gt;Decision tiers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;≥0.72 + proven path: Confirmed, no LLM · 0.48–0.72: arbiter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;arcSize=12;" vertex="1" parent="v29"><mxGeometry x="15" y="220" width="350" height="50" as="geometry"/></mxCell><mxCell id="v34" value="&lt;b&gt;Merge by sink (FR-6)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;one issue per (file, method, CWE)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;arcSize=12;" vertex="1" parent="v29"><mxGeometry x="15" y="280" width="350" height="50" as="geometry"/></mxCell><mxCell id="v35" value="&lt;b&gt;Contradiction check&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;runtime hit on 'safe' code needs direct evidence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;arcSize=12;" vertex="1" parent="v29"><mxGeometry x="15" y="340" width="350" height="50" as="geometry"/></mxCell><mxCell id="v36" value="&lt;b&gt;Explain + fix (B-3, B-4)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;plain-English reason and checklist per link&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;arcSize=12;" vertex="1" parent="v29"><mxGeometry x="15" y="400" width="350" height="50" as="geometry"/></mxCell><mxCell id="v37" value="&lt;b&gt;Auto-verify (B-1, opt-in)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;re-probe Code-only sinks, then re-correlate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="1060" y="770" width="380" height="45" as="geometry"/></mxCell><mxCell id="v38" value="OpenAI (optional, only with a key)" style="swimlane;startSize=28;html=1;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;swimlaneFillColor=#ffffff;arcSize=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="1480" y="280" width="220" height="300" as="geometry"/></mxCell><mxCell id="v39" value="&lt;b&gt;Chat Completions&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;gpt-4o-mini&lt;br&gt;grey-zone link arbiter · filter-bypass payload&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=12;dashed=1;" vertex="1" parent="v38"><mxGeometry x="10" y="40" width="200" height="90" as="geometry"/></mxCell><mxCell id="v40" value="&lt;b&gt;Decisions API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;gpt-6-luna&lt;br&gt;decoy second opinion (advisory)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=12;dashed=1;" vertex="1" parent="v38"><mxGeometry x="10" y="145" width="200" height="80" as="geometry"/></mxCell><mxCell id="v41" value="No key: deterministic rules decide, and the output says so." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="v38"><mxGeometry x="10" y="235" width="200" height="50" as="geometry"/></mxCell><mxCell id="v42" value="&lt;b&gt;SQLite&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;scan records · issues · AI decision cache&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1480" y="610" width="220" height="70" as="geometry"/></mxCell><mxCell id="v43" value="Outputs" style="swimlane;startSize=28;html=1;rounded=1;fillColor=#d0eef0;strokeColor=#2a9da5;fontStyle=1;fontSize=14;swimlaneFillColor=#ffffff;arcSize=4;" vertex="1" parent="1"><mxGeometry x="260" y="840" width="1440" height="100" as="geometry"/></mxCell><mxCell id="v44" value="&lt;b&gt;Prioritised issue list&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Confirmed first, then risk (FR-9)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0eef0;strokeColor=#2a9da5;fontSize=11;arcSize=12;" vertex="1" parent="v43"><mxGeometry x="15" y="38" width="222" height="52" as="geometry"/></mxCell><mxCell id="v45" value="&lt;b&gt;SARIF 2.1.0 + CI gate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;exit 1 on Confirmed high (B-6)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0eef0;strokeColor=#2a9da5;fontSize=11;arcSize=12;" ver